[Unit]
Description=xianyuvpn - Mihomo Proxy Service
After=network.target nss-lookup.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/xianyuvpn
ExecStart=/opt/xianyuvpn/bin/mihomo -d /opt/xianyuvpn/data -f /opt/xianyuvpn/config/config.yaml
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
